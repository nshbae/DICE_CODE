  m_EditorClassIdentifier: 
  tutState: 0
  panel: {fileID: 437706141}
  nowInd: 0
  tutTexts:
  - "\uC774 \uAC8C\uC784\uC740 \uC8FC\uC0AC\uC704\uB97C \uC774\uC6A9\uD574 \uC228\uACA8\uC9C4
    \uB2F5\uC744 \uCC3E\uB294 \uD37C\uC990 \uAC8C\uC784\uC785\uB2C8\uB2E4."
  - "\uB2E8\uC11C\uB294 \uC5B4\uB514\uC5D0\uB098 \uC228\uC5B4\uC788\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.<br>\uAF3C\uAF3C\uD558\uAC8C \uAD00\uCC30\uD558\uACE0,
    \uCE68\uCC29\uD558\uAC8C \uC0DD\uAC01\uD558\uC138\uC694."
  - "\uC5EC\uB7EC \uBA85\uC774 \uD568\uAED8 \uD50C\uB808\uC774 \uD558\uBA74 \uB354
    \uC7AC\uBC0C\uC2B5\uB2C8\uB2E4.<br>\uC0AC\uB78C\uB9C8\uB2E4 \uB2E4\uB978 \uAD00\uC810\uC744
    \uAC00\uC9C0\uACE0 \uC788\uC73C\uB2C8\uAE4C\uC694."
  - "\uD544\uC694\uD558\uB2E4\uBA74 \uBA54\uBAA8\uB098 \uC778\uD130\uB137 \uAC80\uC0C9\uC744
    \uD65C\uC6A9\uD574\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4."
  - "\uC544, \uADF8\uB9AC\uACE0 \uD78C\uD2B8\uB294 ? \uBC84\uD2BC\uC744 \uB20C\uB7EC
    \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB7FC \uD589\uC6B4\uC744 \uBE4C\uC5B4\uC694!"
